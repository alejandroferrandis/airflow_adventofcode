# --- SECRETS / puzzle inputs: never commit ---------------------------------
# AoC asks that per-user puzzle inputs stay private. Inputs live in Postgres,
# not in git. These patterns are a defensive backstop.
.env
*.session
**/input.txt
**/*.input
inputs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.scannerwork/
